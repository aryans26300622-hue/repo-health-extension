{
  "manifest_version": 3,
  "name": "Repo Health Panel",
  "version": "1.0.0",
  "description": "Shows a quick health score for any public GitHub repository.",
    "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Repo Health Panel"
  },
  "host_permissions": ["https://api.github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"]
    }
  ]
}
